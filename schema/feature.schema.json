{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moderncppatlas.dev/schema/feature.schema.json",
  "title": "Feature entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "standard",
    "kind",
    "category",
    "difficulty",
    "status",
    "tier",
    "compilers",
    "tags",
    "alternatives",
    "proposal",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cpp(11|14|17|20|23|26)\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "enum": ["C++11", "C++14", "C++17", "C++20", "C++23", "C++26"]
    },
    "kind": {
      "enum": ["language", "library", "both"]
    },
    "category": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "status": {
      "enum": ["draft", "final", "deprecated", "removed"]
    },
    "tier": {
      "enum": ["A", "B", "C"]
    },
    "compilers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcc", "clang", "msvc"],
      "properties": {
        "gcc": { "type": "string", "minLength": 1 },
        "clang": { "type": "string", "minLength": 1 },
        "msvc": { "type": "string", "minLength": 1 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "proposal": {
      "type": ["string", "null"],
      "pattern": "^(P[0-9]{4}|N[0-9]{4})(R[0-9]+)?$"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ev-[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "level", "reviewers"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": ["manual", "verified"]
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
